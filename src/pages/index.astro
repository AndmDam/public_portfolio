---
import BaseLayout from '../layout/BaseLayout.astro';
import TechGraph from '../components/TechGraph.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const projects = await getCollection('projects');
projects.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="Portafolio">
    <section class="hero">
        <div class="hero-content">
            <h1>Damián Andrango</h1>
            <p class="subtitle">Físico aplicado & Desarrollador de Hardware/Software</p>
            <p class="summary">
                Físico aplicado, especializado en prototipado de instrumentación científica a bajo&nbsp;costo, diseño&nbsp;CAD, sistemas&nbsp;embebidos y procesamiento de datos, señales e imágenes.
            </p>
        </div>
        <img
            src={`${base}/assets/profile.jpeg`}
            alt="Fotografía de Damián Andrango"
            class="hero-photo"
        />
    </section>

    <section id="ecosistema-tecnologico" class="graph-section">
        <h2>
            Mapa de Tecnologías y Proyectos
        </h2>
        <TechGraph />
    </section>

    <section id="proyectos" class="projects-section">
        <h2>Proyectos Técnicos</h2>
        <div class="grid">
            {projects.map((project) => (
                <article class="card">
                    <div class="card-header">
                        <span class="category">{project.data.category}</span>
                        <span class="date">{project.data.date.toISOString().slice(0, 7)}</span>
                    </div>
                    <h3>{project.data.title}</h3>
                    <p>{project.data.tagline}</p>

                    <div class="tools">
                        {project.data.tools.map((tool) => (
                            <span class="badge">{tool}</span>
                        ))}
                    </div>

                    <div class="links">
                        <a 
                            href={`${base}/projects/${project.id}`}
                            class="btn-primary"
                            data-umami-event="ver-caso-tecnico"
                            data-umami-event-proyecto={project.data.title}
                        >
                            Ver Caso Técnico
                        </a>
                        {project.data.githubUrl && (
                            <a href={project.data.githubUrl} target="_blank" rel="noopener noreferrer" class="btn-secondary">GitHub</a>
                        )}
                    </div>
                </article>
            ))}
        </div>
    </section>

    <style>
        .hero {
            display: flex;
            align-items: center;
            justify-content: flex-start;
            gap: 3rem;
            padding: 3rem 0;
            border-bottom: 1px solid var(--border-color);
            margin-bottom: 3rem;
        }
        .hero-content {
            max-width: 720px;
        }
        .hero-photo {
            width: 170px;
            height: 170px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid var(--accent);
            flex-shrink: 0;
        }
        .legend-term {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            vertical-align: baseline;
        }
        .dot {
            display: inline-block;
            width: 13px;
            height: 13px;
            border-radius: 50%;
            flex-shrink: 0;
        }
        .dot-tech {
            background-color: var(--accent);
        }
        .dot-project {
            background-color: #10b981;
        }

        @media (max-width: 640px) {
            .hero {
                flex-direction: column-reverse;
                text-align: center;
            }
            .hero-photo {
                width: 140px;
                height: 140px;
            }
        }
        .hero h1 {
            font-size: 2.5rem;
            color: var(--text-primary);
        }
        .subtitle {
            font-size: 1.25rem;
            color: var(--accent);
            margin-bottom: 1rem;
        }
        .summary {
            color: var(--text-secondary);
            max-width: 780px;
            line-height: 1.65;
            text-wrap: balance;
        }
        .graph-section {
            margin-bottom: 3.5rem;
        }
        .graph-section h2,
        .projects-section h2 {
            margin-bottom: 1.5rem;
            font-size: 1.8rem;
        }
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 1.5rem;
        }
        .card {
            background-color: var(--surface-color);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: transform 0.2s, border-color 0.2s;
        }
        .card:hover {
            transform: translateY(-4px);
            border-color: var(--accent);
        }
        .card-header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 0.75rem;
            font-size: 0.8rem;
        }
        .category {
            color: var(--accent);
            text-transform: uppercase;
            font-weight: bold;
        }
        .date {
            color: var(--text-secondary);
        }
        .card h3 {
            font-size: 1.3rem;
            margin-bottom: 0.5rem;
        }
        .card p {
            color: var(--text-secondary);
            font-size: 0.95rem;
            margin-bottom: 1.25rem;
        }
        .tools {
            display: flex;
            flex-wrap: wrap;
            gap: 0.4rem;
            margin-bottom: 1.5rem;
        }
        .badge {
            background-color: rgba(56, 189, 248, 0.1);
            color: var(--accent);
            padding: 0.2rem 0.5rem;
            border-radius: 4px;
            font-size: 0.75rem;
        }
        .links {
            display: flex;
            gap: 0.75rem;
            margin-top: auto;
        }
        .btn-primary, .btn-secondary {
            text-decoration: none;
            font-size: 0.85rem;
            padding: 0.5rem 1rem;
            border-radius: 4px;
            font-weight: 500;
            transition: background-color 0.2s, opacity 0.2s;
        }
        .btn-primary {
            background-color: var(--accent);
            color: var(--surface-color);
        }
        .btn-primary:hover {
            opacity: 0.9;
        }
        .btn-secondary {
            border: 1px solid var(--border-color);
            color: var(--text-primary);
        }
        .btn-secondary:hover {
            background-color: var(--border-color);
        }
    </style>
</BaseLayout>